{
  "showReasoning": false,
  "colorMode": "default",
  "allowedUrls": [
    "https://grafana.com",
    "https://github.com"
  ],
  "disabledSkills": [],
  "footer": {
    "showModelEffort": false,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAiUsed": true,
    "showAgent": true,
    "showCodeChanges": true,
    "showUsername": false,
    "showSandbox": true,
    "showYolo": true,
    "showCiStatus": true,
    "showSchedules": true,
    "showPullRequest": true,
    "showCustom": true
  },
  "theme": "default",
  "beep": true,
  "beepOnSchedule": false,
  "copyOnSelect": true,
  "inlineImages": false,
  "mergeStrategy": "rebase",
  "notifications": true,
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "pg-agents-marketplace": {
      "source": {
        "source": "github",
        "repo": "procter-gamble/pg-agents-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "domain-terraform@pg-agents-marketplace": true,
    "domain-docker@pg-agents-marketplace": true
  },
  "editorMode": "normal"
}
